---
import type { z } from "astro/zod";
import type { Track } from "src/pages/api/spotify";
import Text from "@components/core/text";
import spotifyLogo from "@assets/spotify.svg";
import { Image } from "astro:assets";
import Card from "@components/core/card.astro";

interface Props {
  track: z.infer<typeof Track>;
}
const { track } = Astro.props;
const { name, artists, external_urls } = track;
---

{
  track && (
    <Card class="bg-[#1F1F1F]">
      <div class="flex justify-between">
        <div class="text-primary-text">
          <Text.H2 className="font-bold text-4xl">
            Whats On <br /> Repeat
          </Text.H2>

          <Image
            src={spotifyLogo}
            alt="Spotify Logo"
            class="pt-8"
            loading={"eager"}
          />
        </div>
      </div>

      <div class="max-w-xl flex flex-col items-end justify-between">
        <div class="flex flex-col items-end">
          <Text.Text className="font-bold text-sm ">{name}</Text.Text>
          <Text.Text className="text-sm">{`- ${artists[0]?.name}`}</Text.Text>
        </div>
        <a
          href={external_urls.spotify}
          class="text-xs text-secondary-text underline relative block truncate"
          target="_blank"
          rel="noreferrer"
        >
          Listen with me!
        </a>
      </div>
    </Card>
  )
}
